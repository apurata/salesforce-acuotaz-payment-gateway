<?xml version="1.0" encoding="UTF-8"?>
<metadata xmlns="http://www.demandware.com/xml/impex/metadata/2006-10-31">
    <!-- Extend SitePreferences system object with Acuotaz credentials -->
    <type-extension type-id="SitePreferences">
        <custom-attribute-definitions>
            <attribute-definition attribute-id="acuotazBearerToken">
                <display-name xml:lang="x-default">Acuotaz Bearer Token</display-name>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>

            <attribute-definition attribute-id="acuotazPosClientId">
                <display-name xml:lang="x-default">Acuotaz POS Client ID</display-name>
                <type>string</type>
                <mandatory-flag>false</mandatory-flag>
                <externally-managed-flag>false</externally-managed-flag>
            </attribute-definition>
        </custom-attribute-definitions>

        <!-- Optional: group to organize in BM UI -->
        <group-definitions>
            <attribute-group group-id="Acuotaz">
                <display-name xml:lang="x-default">Acuotaz</display-name>
                <attribute attribute-id="acuotazBearerToken"/>
                <attribute attribute-id="acuotazPosClientId"/>
            </attribute-group>
        </group-definitions>
    </type-extension>
</metadata>
